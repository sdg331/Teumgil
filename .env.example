# npm run setup:local generates a private .env.local with a random secret.
# PGlite runs on the server for local development only.
DATABASE_URL=pglite://.harness/app-db
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
NEXT_TELEMETRY_DISABLED=1
# A deployed service requires a shared PostgreSQL connection and an HTTPS URL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/teumgil
